@charset "utf-8";

:root { --navy: #123b67; --blue: #1769aa; --blue-light: #eaf3fc; --background: #f3f6fa; --white: #ffffff; --text: #243447; --muted: #718096; --border: #e2e8f0; --green: #168653; --yellow: #d99a16; --red: #d64545; --gray: #788391; --shadow: 0 4px 18px rgba(25, 55, 90, 0.07); }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { font-family: Arial, Helvetica, sans-serif; background: var(--background); color: var(--text); line-height: 1.5; min-height: 100vh; }

.app-header { background: linear-gradient(135deg, rgb(18, 59, 103), rgb(23, 105, 170)); color: var(--white); padding: 25px 18px; box-shadow: var(--shadow); }

.brand { display: flex; align-items: center; gap: 13px; max-width: 850px; margin: auto; }

.brand-icon { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 2px solid rgba(255, 255, 255, 0.6); border-radius: 14px; font-size: 18px; font-weight: 800; }

.brand h1 { font-size: 23px; letter-spacing: 0.3px; }

.brand p { font-size: 12px; opacity: 0.85; }

.container { width: 100%; max-width: 850px; margin: 0px auto; padding: 20px 15px 35px; }

.summary { margin-bottom: 20px; }

.summary h2 { font-size: 21px; margin-bottom: 3px; }

.summary > p { color: var(--muted); font-size: 14px; margin-bottom: 15px; }

.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }

.summary-card { background: var(--white); border-radius: 13px; padding: 16px 8px; text-align: center; box-shadow: var(--shadow); border: 1px solid var(--border); }

.summary-card span { display: block; font-size: 27px; font-weight: 800; color: var(--navy); }

.summary-card p { font-size: 12px; color: var(--muted); }

.panel { background: var(--white); border-radius: 16px; padding: 20px 17px; margin-bottom: 18px; border: 1px solid var(--border); box-shadow: var(--shadow); }

.panel h2 { font-size: 18px; color: var(--navy); margin-bottom: 17px; }

label { display: block; font-size: 13px; font-weight: 700; color: var(--text); margin: 13px 0px 6px; }

input, textarea, select { width: 100%; min-height: 47px; padding: 12px; border: 1px solid rgb(213, 222, 234); border-radius: 10px; background: rgb(251, 252, 254); color: var(--text); font-family: inherit; font-size: 15px; outline: none; transition: border 0.2s, box-shadow 0.2s; }

textarea { min-height: 85px; resize: vertical; }

input:focus, textarea:focus, select:focus { border-color: var(--blue); box-shadow: rgba(23, 105, 170, 0.12) 0px 0px 0px 3px; background: var(--white); }

input::placeholder, textarea::placeholder { color: rgb(160, 170, 186); }

button { display: block; width: 100%; min-height: 48px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 11px; margin-top: 17px; padding: 12px 16px; background: var(--blue); color: var(--white); font-size: 15px; font-weight: 700; cursor: pointer; transition: transform 0.15s, background 0.15s; }

button:active { transform: scale(0.98); }

button:hover { background: var(--navy); }

.filters { margin-bottom: 15px; }

#visits-list { display: flex; flex-direction: column; gap: 12px; }

.empty-message { padding: 20px 10px; text-align: center; color: var(--muted); font-size: 14px; background: rgb(248, 250, 252); border-radius: 10px; }

.visit-card { padding: 15px; border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 5px solid var(--yellow); border-radius: 12px; background: rgb(255, 255, 255); box-shadow: rgba(25, 55, 90, 0.04) 0px 2px 8px; }

.visit-card h3 { font-size: 16px; color: var(--navy); margin-bottom: 5px; }

.visit-card p { font-size: 13px; color: var(--muted); margin-top: 5px; overflow-wrap: anywhere; }

.status-pendiente { border-left-color: var(--yellow); }

.status-visitado { border-left-color: var(--green); }

.status-no-localizado { border-left-color: var(--red); }

.status-seguimiento { border-left-color: var(--blue); }

.status-reprogramado { border-left-color: var(--gray); }

.map-link { display: block; text-align: center; text-decoration: none; background: rgb(234, 243, 252); color: rgb(18, 59, 103); padding: 13px; margin-top: 14px; border-radius: 10px; font-weight: 700; font-size: 14px; }

.map-link:active { background: rgb(213, 232, 250); }

.visit-card .delete-visit { background: rgb(255, 240, 240); color: rgb(184, 50, 50); border: 1px solid rgb(242, 204, 204); margin-top: 10px; }

.visit-card .delete-visit:hover { background: rgb(255, 224, 224); }

#expense-summary { margin-top: 15px; padding: 13px; background: var(--blue-light); color: var(--navy); border-radius: 10px; font-weight: 700; font-size: 14px; }

footer { text-align: center; padding: 20px 12px; color: var(--muted); font-size: 12px; }

@media (min-width: 700px) {
  .container { padding: 30px 22px 45px; }
  .app-header { padding: 30px 25px; }
  .panel { padding: 25px; }
  .summary-card { padding: 20px; }
  .summary-card span { font-size: 32px; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { scroll-behavior: auto !important; transition: none !important; }
}
